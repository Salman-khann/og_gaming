NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
# Server-only: required for protected writes, team applications and administration.
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
NEXT_PUBLIC_SITE_URL=http://localhost:3000
FACEIT_API_KEY=your-faceit-data-api-key

# FACEIT Connect credentials; register via node scripts/configure-faceit.mjs.
FACEIT_CLIENT_ID=
FACEIT_CLIENT_SECRET=
# Must match the Redirect URL registered in FACEIT's Developer Portal.
# Use your Supabase project URL, including for localhost development.
FACEIT_REDIRECT_URI=https://your-project.supabase.co/auth/v1/callback

# Optional: Steam Web API profile lookup; public Steam profiles are used as fallback.
STEAM_WEB_API_KEY=

# Optional automatic admin alerts. Set at least one complete channel.
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_CHAT_ID=
RESEND_API_KEY=
ADMIN_EMAIL=
NOTIFICATION_FROM_EMAIL=

# Strong random secret for the server worker's Authorization: Bearer header.
CRON_SECRET=
# Self-hosting only: a client-IP header overwritten by your trusted reverse proxy.
# Vercel uses its own trusted client address automatically.
TRUSTED_CLIENT_IP_HEADER=
# Required in production: at least 32 random bytes encoded as hex. Server-only.
# Generate into your private environment file or hosting secret manager; never commit it.
RATE_LIMIT_SECRET=
